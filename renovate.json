{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "internalChecksFilter": "strict",
    "updateNotScheduled": false,
    "minimumReleaseAge": "21 days",
    "postUpdateOptions": ["gomodTidy"],
    "pre-commit": {
        "enabled": true
    },
    "pinDigests": true
}
